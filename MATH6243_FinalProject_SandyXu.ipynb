      "source": [
        "Now, I'm implementing the Bayesian model"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 30,
      "id": "code_22",
      "metadata": {
        "id": "code_22",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 125,
          "referenced_widgets": [
            "f2283007c75f4fcdb44c239a075f3a2b",
            "43f711c9f4e944a7857d2b585549a2cd"
          ]
        },
        "outputId": "a8f447e4-0ec8-452f-f53b-bf47891e3b10"
      },
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "Output()"
            ],
            "application/vnd.jupyter.widget-view+json": {
              "version_major": 2,
              "version_minor": 0,
              "model_id": "f2283007c75f4fcdb44c239a075f3a2b"
