      "id": "md_1",
      "metadata": {
        "id": "md_1"
      },
      "source": [
        "## Further Data Cleaning\n",
        "\n",
        "To help with class imbalance, prevent high cardinality, and help run the code without it taking a very long time, we grouped some of the categories in the features (both the predictors and target feature of force type). We also decided to drop neighborhood and primary offense as features. Later, we decided to randomly subsample from the Force Type groups since the class imbalance was still very high. So we randomly subsampled from each of the 4 groups 478 observations (to match the one with the least number of observations which was \"Guns\")."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 11,
      "id": "code_2",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "code_2",
        "outputId": "950a0c04-4947-46a4-e199-4b1b1ea6bde4"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Shape: (29716, 8)\n",
            "Updated features: ['ForceType', 'Sex', 'Race', 'TypeOfResistance', 'Problem']\n"
          ]
        }
      ],
      "source": [
        "import pymc as pm\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import arviz as az\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.metrics import classification_report, accuracy_score, mean_squared_error\n",
        "from sklearn.preprocessing import TargetEncoder, LabelEncoder\n",
        "\n",
        "# Checking the shape of the dataset\n",
        "df = pd.read_csv(\"cleaned_data.csv\")\n",
        "print(\"Shape:\", df.shape)\n",
        "\n",
        "# Dropping the unnamed column, Neighborhood, and PrimaryOffense\n",
        "df = df.drop(columns=[\"Unnamed: 0\", \"Neighborhood\", \"PrimaryOffense\"])\n",
        "\n",
        "# Printing the updated feature list\n",
        "print(\"Updated features:\", df.columns.tolist())\n"
      ]
    },
